{
  "name": "mars-navigator",
  "version": "0.2.0",
  "main": "index.ts",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "cd .. && node app/scripts/py.mjs -m unittest discover -s mars_streetview/tests && node app/scripts/py.mjs --system -m unittest discover -s tests",
    "test:all": "npm run typecheck && npm test && npm run test:py",
    "doctor": "expo-doctor",
    "design": "node scripts/serve-design.mjs",
    "data": "node scripts/serve-data.mjs",
    "data:pack": "node scripts/package-data.mjs",
    "data:fetch": "node scripts/fetch-data.mjs",
    "export:web": "expo export --platform web",
    "assistant": "node scripts/serve-assistant.mjs",
    "panos": "cd ../mars_streetview && node ../app/scripts/py.mjs --system fetch_raw.py && node ../app/scripts/py.mjs build_panos.py manifest.json --src raw --out ../app/data/panos"
  },
  "private": true
}
